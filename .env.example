
# Copy to .env (for local only) and adjust
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/insurdb
# Optional: alternative for quick local tests (no Postgres)
# DATABASE_URL=sqlite:///local.db

# ---------------------------------------------------------------------------
# Data source selection
# ---------------------------------------------------------------------------
# Set DATA_SOURCE=kaggle to ingest a Kaggle dataset instead of generating
# synthetic data.  Leave unset (or set to "synthetic") for the default flow.
# DATA_SOURCE=synthetic

# ---------------------------------------------------------------------------
# Kaggle API credentials  (required when DATA_SOURCE=kaggle)
# ---------------------------------------------------------------------------
# Option 1 — environment variables (recommended for CI / containers)
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key
#
# Option 2 — credential file (recommended for local dev)
#   Download kaggle.json from kaggle.com → Account → API and place it at:
#   ~/.kaggle/kaggle.json
#
# Dataset / config selection
# KAGGLE_CONFIG=config/kaggle.yaml   # path to the Kaggle YAML config
