[flake8]
max-line-length = 100
extend-ignore = E203, W503, E501
exclude =
    .git,
    __pycache__,
    build,
    dist,
    *.egg-info,
    .venv,
    .tox,
    .mypy_cache,
    .pytest_cache,
    notebooks,
    concepts,
    sas-python-examples
per-file-ignores =
    __init__.py:F401
    tests/*:S101,E402
