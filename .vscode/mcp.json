{
    "servers": {
        "sonarqube": {
            "command": "docker",
            "args": [
                "run",
                "--init",
                "--pull=always",
                "-i",
                "--rm",
                "-e",
                "SONARQUBE_TOKEN",
                "-e",
                "SONARQUBE_ORG",
                "-e",
                "SONARQUBE_PROJECT_KEY",
                "mcp/sonarqube"
            ],
            "env": {
                "SONARQUBE_TOKEN": "${input:sonarqubeToken}",
                "SONARQUBE_ORG": "sahithisarvepalli",
                "SONARQUBE_PROJECT_KEY": "sahithisarvepalli_insurance-analytics-project"
            }
        }
    },
    "inputs": [
        {
            "id": "sonarqubeToken",
            "type": "promptString",
            "description": "SonarCloud user token (generate at https://sonarcloud.io/account/security)",
            "password": true
        }
    ]
}
