{
    "name": "Insurance Analytics - Production",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "remoteEnv": {
        "DATABASE_URL": "postgresql://postgres:postgres@db:5432/insurdb",
        "PYTHONPATH": "/workspaces/${localWorkspaceFolderBasename}",
        "JUPYTER_ENABLE_LAB": "yes"
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "forwardPorts": [5432, 8888, 8889],
    "portsAttributes": {
        "5432": {
            "label": "PostgreSQL",
            "onAutoForward": "silent"
        },
        "8888": {
            "label": "Jupyter Lab",
            "onAutoForward": "notify"
        },
        "8889": {
            "label": "Jupyter Notebook",
            "onAutoForward": "notify"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-python.pylint",
                "ms-python.black-formatter",
                "ms-python.isort",
                "ms-databasetools.mssql",
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.vscode-jupyter-slideshow",
                "eamodio.gitlens",
                "GitHub.copilot"
            ],
            "settings": {
                "python.defaultInterpreterPath": "${containerEnv:PYTHONPATH}",
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": true,
                "python.formatting.provider": "black",
                "python.formatting.blackArgs": ["--line-length=100"],
                "[python]": {
                    "editor.defaultFormatter": "ms-python.python",
                    "editor.formatOnSave": true,
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": true
                    }
                },
                "jupyter.askForKernelRestart": false,
                "jupyter.alwaysTrustNotebooks": true,
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/*.pyc": true,
                    "**/.pytest_cache": true,
                    "**/.mypy_cache": true
                }
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    }
}