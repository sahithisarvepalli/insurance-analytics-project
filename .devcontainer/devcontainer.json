{
    "name": "Insurance Analytics - Production",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "remoteEnv": {
        "DATABASE_URL": "postgresql://postgres:postgres@db:5432/insurdb",
        "PYTHONPATH": "/workspaces/${localWorkspaceFolderBasename}",
        "JUPYTER_ENABLE_LAB": "yes"
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "forwardPorts": [5432, 8080, 8888, 8889],
    "portsAttributes": {
        "5432": {
            "label": "PostgreSQL",
            "onAutoForward": "silent"
        },
        "8080": {
            "label": "Airflow UI",
            "onAutoForward": "notify"
        },
        "8888": {
            "label": "Jupyter Lab",
            "onAutoForward": "notify"
        },
        "8889": {
            "label": "Jupyter Notebook",
            "onAutoForward": "notify"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-python.pylint",
                "ms-python.black-formatter",
                "ms-python.isort",
                "ms-python.flake8",
                "ms-python.mypy-type-checker",
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.vscode-jupyter-slideshow",
                "ms-databasetools.mssql",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg",
                "eamodio.gitlens",
                "GitHub.copilot",
                "ms-vscode.vscode-eslint",
                "esbenp.prettier-vscode",
                "ms-vscode.vscode-markdownlint",
                "streetsidesoftware.code-spell-checker",
                "gruntfuggly.todo-tree",
                "ms-vscode.vscode-docker",
                "ms-vscode.vscode-git-graph",
                "ryanluker.vscode-coverage-gutters",
                "hbenl.vscode-test-explorer",
                "ms-vscode.test-adapter-converter",
                "ms-vscode.vscode-json",
                "redhat.vscode-yaml"
            ],
            "settings": {
                "python.defaultInterpreterPath": "${containerEnv:PYTHONPATH}",
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": true,
                "python.linting.flake8Enabled": true,
                "python.linting.mypyEnabled": true,
                "python.linting.banditEnabled": true,
                "python.linting.ruffEnabled": true,
                "python.formatting.provider": "black",
                "python.formatting.blackArgs": ["--line-length=100"],
                "python.sortImports.args": ["--profile", "black"],
                "python.testing.pytestEnabled": true,
                "python.testing.unittestEnabled": false,
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter",
                    "editor.formatOnSave": true,
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": true,
                        "source.fixAll": true
                    }
                },
                "[json]": {
                    "editor.defaultFormatter": "ms-vscode.vscode-json",
                    "editor.formatOnSave": true
                },
                "[yaml]": {
                    "editor.defaultFormatter": "redhat.vscode-yaml",
                    "editor.formatOnSave": true
                },
                "[markdown]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.formatOnSave": true,
                    "editor.wordWrap": "on",
                    "editor.quickSuggestions": {
                        "comments": "off",
                        "strings": "off",
                        "other": "off"
                    }
                },
                "editor.rulers": [100],
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "editor.detectIndentation": false,
                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true,
                "files.trimFinalNewlines": true,
                "jupyter.askForKernelRestart": false,
                "jupyter.alwaysTrustNotebooks": true,
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/*.pyc": true,
                    "**/.pytest_cache": true,
                    "**/.mypy_cache": true,
                    "**/.coverage": true,
                    "**/htmlcov": true
                },
                "cSpell.language": "en",
                "cSpell.enableFiletypes": [
                    "python",
                    "markdown",
                    "yaml",
                    "json"
                ],
                "todo-tree.tree.showBadges": true,
                "todo-tree.tree.showCountsInTree": true,
                "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",
                "sqltools.connections": [
                    {
                        "name": "Insurance DB",
                        "driver": "PostgreSQL",
                        "server": "db",
                        "port": 5432,
                        "database": "insurdb",
                        "username": "postgres",
                        "password": "postgres"
                    }
                ]
            }
        }
    },
    "features": {}
}
