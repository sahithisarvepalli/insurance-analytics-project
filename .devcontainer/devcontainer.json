{
    "name": "Insurance Analytics",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "remoteUser": "root",
    "workspaceFolder": "/workspaces/insurance-analytics-project",
    "shutdownAction": "stopCompose",
    "containerUser": "root",
    "containerEnv": {
        "DATABASE_URL": "postgresql://postgres:postgres@db:5432/insurdb",
        "PYTHONPATH": "/workspaces/insurance-analytics-project",
        "DOCKER_HOST": "unix:///var/run/docker.sock",
        "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
    },
    "remoteEnv": {
        "DATABASE_URL": "postgresql://postgres:postgres@db:5432/insurdb",
        "PYTHONPATH": "/workspaces/insurance-analytics-project"
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "initializeCommand": "bash .devcontainer/build-sonar-mcp.sh",
    "forwardPorts": [5432, 8080, 8888, 8889],
    "portsAttributes": {
        "5432": {
            "label": "PostgreSQL",
            "onAutoForward": "silent"
        },
        "8080": {
            "label": "Airflow UI",
            "onAutoForward": "notify"
        },
        "8888": {
            "label": "Jupyter Lab",
            "onAutoForward": "notify"
        },
        "8889": {
            "label": "Jupyter Notebook",
            "onAutoForward": "notify"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "charliermarsh.ruff",
                "sonarsource.sonarlint-vscode",
                "ms-python.mypy-type-checker",
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.vscode-jupyter-slideshow",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg",
                "eamodio.gitlens",
                "GitHub.copilot",
                "ms-vscode.vscode-markdownlint",
                "streetsidesoftware.code-spell-checker",
                "gruntfuggly.todo-tree",
                "ms-vscode.vscode-docker",
                "ryanluker.vscode-coverage-gutters",
                "redhat.vscode-yaml"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.testing.pytestEnabled": true,
                "python.testing.unittestEnabled": false,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true,
                    "editor.codeActionsOnSave": {
                        "source.fixAll.ruff": true,
                        "source.organizeImports.ruff": true
                    }
                },
                "[json]": {
                    "editor.formatOnSave": true
                },
                "[yaml]": {
                    "editor.defaultFormatter": "redhat.vscode-yaml",
                    "editor.formatOnSave": true
                },
                "[markdown]": {
                    "editor.wordWrap": "on"
                },
                "editor.rulers": [100],
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true,
                "files.trimFinalNewlines": true,
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/*.pyc": true,
                    "**/.pytest_cache": true,
                    "**/.mypy_cache": true,
                    "**/.coverage": true,
                    "**/htmlcov": true
                },
                "sqltools.connections": [
                    {
                        "name": "Insurance DB",
                        "driver": "PostgreSQL",
                        "server": "db",
                        "port": 5432,
                        "database": "insurdb",
                        "username": "postgres",
                        "password": "postgres"
                    }
                ]
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    }
}
