# Copy this file to .devcontainer/.env and fill in your value.
# Docker Compose reads this file automatically when building the dev container.
#
# GITHUB_REPOSITORY_OWNER – the GitHub account or org that owns this repo.
# This is used to construct the GHCR image name:
#   ghcr.io/<GITHUB_REPOSITORY_OWNER>/insurance-analytics-devcontainer:latest
#
# In GitHub Codespaces this variable is injected automatically; you only need
# this file for fully local (non-Codespaces) Docker development.
#
# To pull the pre-built image after setting this:
#   docker compose -f .devcontainer/docker-compose.yml pull app
#
GITHUB_REPOSITORY_OWNER=your-github-username-or-org
